<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>vTerm</AssemblyName>
    <RootNamespace>vTerm</RootNamespace>
    <StartupObject>vTerm.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- made by running vTerm.exe with make-icon (the drawing is src\Ui\Brand.cs), in vShell's default colours; the window's icon follows the theme -->
    <ApplicationIcon>vterm.ico</ApplicationIcon>
    <Version>0.2.2</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- the file panel (SFTP) and copying your key to a server -->
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <!-- the terminal itself: libghostty-vt (Ghostty's terminal engine, MIT - lib\libghostty-vt\README.txt); vTerm draws its screen.
         Next to vTerm.exe when built, inside it when published as one file (IncludeNativeLibrariesForSelfExtract) -->
    <None Include="lib\libghostty-vt\ghostty-vt.dll" Link="ghostty-vt.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- the suite's shared library (git submodule vSuite.Core): theme, glass, styles, questions, log, updater, Options blocks -->
  <ItemGroup>
    <ProjectReference Include="vSuite.Core\vSuite.Core\vSuite.Core.csproj" />
    <Compile Remove="vSuite.Core\**" />
    <Page Remove="vSuite.Core\**" />
    <None Remove="vSuite.Core\**" />
    <EmbeddedResource Remove="vSuite.Core\**" />
    <Resource Remove="vSuite.Core\**" />
  </ItemGroup>

  <!-- the tests (tests\vTerm.Tests) are their own project: dotnet test tests\vTerm.Tests -->
  <ItemGroup>
    <Compile Remove="tests\**" />
    <Page Remove="tests\**" />
    <None Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
  </ItemGroup>

  <!-- bench\ is a test bench of its own (libghostty-vt against xterm.js), not part of vTerm -->
  <ItemGroup>
    <Compile Remove="bench\**" />
    <Page Remove="bench\**" />
    <None Remove="bench\**" />
    <EmbeddedResource Remove="bench\**" />
  </ItemGroup>

</Project>